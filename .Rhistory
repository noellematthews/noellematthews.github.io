) %>%
ggplot(aes(x = street_type, y = bikeped_crashes_per_10k, fill = street_type)) +
geom_boxplot(outlier.shape = NA, width = 0.6) +
coord_cartesian(ylim = c(0, 5)) +
labs(
title = "Bike/Ped Crashes per 10,000 Vehicles",
subtitle = "Normalized Crash Rates by Street Infrastructure Type (Portland, 2007–2022)",
